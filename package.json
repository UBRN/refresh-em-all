{
  "name": "refresh-em-all",
  "version": "2.6.0",
  "description": "Reload all accessible tabs in every window while bypassing the local cache and preserving supported media state.",
  "main": "background.js",
  "scripts": {
    "generate-icons": "node generate-icons.js",
    "package": "node scripts/package-extension.js",
    "package:verify": "node scripts/package-extension.js --verify-only",
    "store-assets:capture": "node scripts/chrome-web-store/capture-screenshots.js",
    "store-assets:promo": "node scripts/chrome-web-store/generate-promo.js",
    "store-assets:verify": "node scripts/chrome-web-store/verify-assets.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --expose-gc --inspect-brk ./node_modules/.bin/jest --runInBand",
    "e2e": "node tests/e2e/run.js",
    "e2e:package": "node tests/e2e/package-smoke.js",
    "e2e:reliability:smoke": "node tests/e2e/reliability.js --profile=smoke",
    "e2e:reliability:medium": "node tests/e2e/reliability.js --profile=medium",
    "e2e:reliability": "node tests/e2e/reliability.js --profile=full",
    "e2e:reliability:large": "node tests/e2e/reliability.js --profile=large"
  },
  "author": "UBRN",
  "license": "MIT",
  "engines": {
    "node": ">=22.12 <26"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/jest": "^29.5.12",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "puppeteer": "25.12.0",
    "sharp": "^0.32.1"
  }
}
